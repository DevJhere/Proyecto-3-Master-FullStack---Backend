# Copia este archivo a .env y rellénalo. NUNCA subas el .env real al repositorio.

# --- Base de datos (MongoDB Atlas o local) ---
DB_URL=mongodb+srv://<usuario>:<password>@<cluster>/pedagogia?retryWrites=true&w=majority

# --- Servidor ---
PORT=3000

# --- Autenticación ---
# Cadena larga y aleatoria para firmar los tokens JWT (p. ej. generada con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=<cadena-larga-y-aleatoria>

# --- Cloudinary (subida de avatares y documentos) ---
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
# Nombre de la imagen por defecto: los avatares que la contengan no se borran de Cloudinary
IMAGE_DEFAULT=profile-default.jpg

# --- Seguridad ---
# Orígenes del frontend autorizados por CORS (varios separados por comas, sin barra final).
# En desarrollo, si se deja vacío, se permite http://localhost:5173. En producción, si se deja vacío, no se permite ningún origen.
CORS_ORIGIN=http://localhost:5173

# Solo si el backend está detrás de un proxy (Render, Railway, Heroku...): nº de proxies de confianza.
# Necesario para que el límite de intentos de login use la IP real del cliente. Déjalo vacío en local.
# TRUST_PROXY=1

# Pon NODE_ENV=production en el servidor de producción.
# NODE_ENV=production
